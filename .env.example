# Copy this file to .env and fill in your keys.
# .env is gitignored. Never commit real keys, and never paste them into a chat.

# --- Broker (required to trade) ---------------------------------------------
# Paper trading keys from https://app.alpaca.markets  (switch to Paper, then API Keys)
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Paper endpoint. Changing this to https://api.alpaca.markets points the agent
# at real money, and it will still refuse to trade unless you also set
# allow_live_trading=True in tbot/config.py AND pass --i-understand-the-risk.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Researcher (optional) ---------------------------------------------------
# From https://console.anthropic.com  (API keys). Pay as you go, roughly a few
# cents a day at this watchlist size. Without it the news review is skipped and
# only the earnings filter runs.
ANTHROPIC_API_KEY=

# Override the models if you want. Defaults are fine.
# RESEARCH_MODEL=claude-haiku-4-5-20251001
# BRIEFING_MODEL=claude-sonnet-5
